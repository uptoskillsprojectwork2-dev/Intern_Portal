NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/intern_portal
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=lax

BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
BREVO_SENDER_EMAIL=verified-sender@example.com

# Optional cache and scheduled job settings
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
DRY_RUN=true
JOBS_TIMEZONE=Asia/Kolkata

# Optional certificate backup / Mongo seed settings
CERTIFICATE_BACKUP_PATH=
MONGO_SEED_HOSTS=
MONGO_SRV_OPTIONS=
